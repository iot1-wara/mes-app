# ============================================
# MES Production Control System - Environment
# ============================================

# --- Database (PostgreSQL/TimescaleDB) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=mes_admin
DB_PASSWORD=your_secure_password_here
DB_DATABASE=mes_production

# --- JWT Authentication ---
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=24h

# --- OPC UA Configuration ---
OPC_UA_STATIONS=[{"id":1,"address":"opc.tcp://s7-1500-st1:4840","name":"Station 1","nodePrefix":"","stMesDbName":"","dbProcessDataDbName":""},{"id":2,"address":"opc.tcp://s7-1500-st2:4840","name":"Station 2","nodePrefix":"","stMesDbName":"","dbProcessDataDbName":""},{"id":3,"address":"opc.tcp://s7-1500-st3:4840","name":"Station 3","nodePrefix":"","stMesDbName":"","dbProcessDataDbName":""}]
OPCUA_SECURITY_MODE=none

# --- MQTT Configuration ---
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=mes-edge-gateway
MQTT_QOS=1

# --- Application ---
PORT=3000
NODE_ENV=development
